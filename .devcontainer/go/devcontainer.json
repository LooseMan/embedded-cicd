// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/go
{
	"name": "Go v1.22 (Bookworm)",
	"build": {
		"dockerfile": "../../go/Containerfile",
		"context": "../..",
		"target": "build"
	},
	"workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}/go",
	"runArgs": [
		"--name",
		"embedded-cicd-go",
		"--network",
		"embedded-cicd-network"
	],
	"customizations": {
		"vscode": {
			"extensions": [
				"golang.go"
			]
		}
	}
}
